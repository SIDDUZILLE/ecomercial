# Hostinger Apache configuration
RewriteEngine On

# Route /api/* requests to api.php
RewriteRule ^api/upload-image$ api.php?action=upload-image [QSA,L]
RewriteRule ^api/products$ api.php?action=products [QSA,L]
RewriteRule ^api/categories$ api.php?action=categories [QSA,L]
RewriteRule ^api/status$ api.php?action=status [QSA,L]
